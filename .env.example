# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Toda integração sem variável configurada degrada com elegância:
# o sistema mostra um estado vazio e nada quebra (nem o build).

# ─────────────────────────────────────────────────────────────
# SERVIDOR — segredos. Lidos só pelas funções em /api.
# NUNCA use o prefixo VITE_ nestas: ele publica a variável no navegador.
# ─────────────────────────────────────────────────────────────

# Assistente de IA — Google Gemini, plano gratuito (aistudio.google.com/apikey).
GOOGLE_GENERATIVE_AI_API_KEY=
# ID do modelo. Vazio = gemini-3.5-flash-lite (maior cota gratuita em out/2026).
GEMINI_MODEL=

# Rate limit do assistente — Upstash Redis.
# Sem estas variáveis, o limite usa memória local (dev: pulado, com aviso no console).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Spotify — app Música e mini player.
# O refresh token é gerado com `npm run spotify:token` e expira em 6 meses.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# WakaTime — app Atividade.
# URLs dos embeds em formato JSON (wakatime.com/share/embed), últimos 7 dias.
WAKATIME_LANGUAGES_URL=
WAKATIME_ACTIVITY_URL=

# GitHub — app GitHub. OPCIONAL: sem token o app funciona com a API pública
# (60 requisições/h por IP, compartilhadas na Vercel). Com um token fine-grained
# (github.com/settings/personal-access-tokens: "Public repositories", nenhuma
# permissão extra), o limite sobe para 5.000/h e o gráfico de contribuições
# vem da API GraphQL oficial.
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────
# CLIENTE — públicas por design (vão para o JavaScript do navegador).
# ─────────────────────────────────────────────────────────────

# EmailJS — formulário de Contato.
# Restrinja os domínios permitidos no painel do EmailJS (Vercel + localhost).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID_FOR_ME=
VITE_EMAILJS_TEMPLATE_ID_FOR_SENDER=
VITE_EMAILJS_PUBLIC_KEY=

# URL pública do site, sem barra no final (Open Graph, sitemap, hreflang).
VITE_SITE_URL=http://localhost:5173
